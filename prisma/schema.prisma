generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                String   @id @default(cuid())
  name              String
  description       String?
  barcode           String?
  price             BigInt
  category          String
  imageUrl          String?
  stock             Int      @default(0)
  isActive          Boolean  @default(true)
  isRecommended     Boolean  @default(false)
  isOnlineExclusive Boolean  @default(false) // <--- 여기에 추가했습니다
  isPopular         Boolean  @default(false) // 인기상품
  isOutOfStock      Boolean  @default(false)
  recommendedOrder  Int      @default(0)
  popularOrder      Int      @default(0) // 인기상품 정렬 순서
  maxOrderQuantity  Int?     // 최대 주문 수량 (null 또는 0이면 제한 없음)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  orderItems        OrderItem[]

  @@index([category])
  @@index([isActive])
  @@index([isRecommended])
  @@index([isOnlineExclusive])
  @@index([isPopular])
  @@index([isOutOfStock])
  @@index([barcode])
  @@index([createdAt])
}

model Order {
  id               String          @id @default(cuid())
  orderNumber      String          @unique
  customerName     String
  customerPhone    String
  fulfillmentType  FulfillmentType  @default(DELIVERY)
  deliveryAddress  String
  deliveryEntrance String?
  pickupTime       String?
  memo             String?
  paymentMethod    PaymentMethod?
  outOfStockPolicy OutOfStockPolicy @default(CONTACT)
  status           OrderStatus      @default(PENDING)
  totalAmount      Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  items            OrderItem[]

  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([fulfillmentType])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String   @default("")
  quantity    Int
  unitPrice   Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  APPROVED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  ONSITE_CARD
  ONSITE_CASH
  BANK_TRANSFER
}

enum OutOfStockPolicy {
  SUBSTITUTE
  CANCEL_ONLY
  CONTACT
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // CREATE, UPDATE, DELETE
  entity      String   // Product, Order, etc.
  entityId    String
  changes     String?  // JSON string of changes
  userId      String?  // Admin user who made the change
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
}

model Flyer {
  id        String   @id @default(cuid())
  imageUrl  String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([isActive])
}